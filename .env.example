# ==============================================================================
# NOC INFRA Dashboard — variables d'environnement
# Copiez ce fichier en .env et remplacez TOUTES les valeurs CHANGE_ME.
# Générer un secret :  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ne jamais commiter le fichier .env.
# ==============================================================================

# PostgreSQL
POSTGRES_DB=noc_dashboard
POSTGRES_USER=noc_admin
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://noc_admin:CHANGE_ME@db:5432/noc_dashboard

# InfluxDB (le même jeton sert à l'initialisation et à l'application)
DOCKER_INFLUXDB_INIT_USERNAME=noc_operator
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_ME
DOCKER_INFLUXDB_INIT_RETENTION=90d
INFLUXDB_TOKEN=CHANGE_ME
INFLUXDB_ORG=noc_org
INFLUXDB_BUCKET=noc_metrics

# Chiffre les mots de passe des équipements en base. Ne pas changer sans
# suivre docs/ROTATION_SECRETS.md (sinon les mots de passe sont perdus).
SECRET_KEY=CHANGE_ME
# Signe les sessions utilisateurs. DOIT être différent de SECRET_KEY.
JWT_SECRET=CHANGE_ME
# Durée d'une session (minutes)
ACCESS_TOKEN_MINUTES=480

# Premier compte administrateur, créé seulement si aucun utilisateur n'existe.
# Après la première connexion : changez ce mot de passe dans l'interface puis videz la variable.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# Identifiants SMTP (facultatif ; le serveur et les destinataires se règlent dans l'interface)
SMTP_USER=
SMTP_PASSWORD=

# Port HTTP publié par Nginx, et adresse d'écoute sur l'hôte.
# Derrière un reverse proxy (Traefik, Dokploy…) : HTTP_BIND=127.0.0.1 pour ne pas exposer le port.
HTTP_PORT=80
HTTP_BIND=0.0.0.0
# Développement uniquement (Vite sur un autre port) : origines autorisées, séparées par des virgules
CORS_ORIGINS=
