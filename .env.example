# ==============================================================================
# NOC INFRA Dashboard — variables d'environnement
# Copiez ce fichier en .env et remplacez TOUTES les valeurs CHANGE_ME.
# Générer un secret :  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ne jamais commiter le fichier .env.
# ==============================================================================

# PostgreSQL
POSTGRES_DB=noc_dashboard
POSTGRES_USER=noc_admin
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://noc_admin:CHANGE_ME@db:5432/noc_dashboard

# InfluxDB (le même jeton sert à l'initialisation et à l'application)
DOCKER_INFLUXDB_INIT_USERNAME=noc_operator
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_ME
DOCKER_INFLUXDB_INIT_RETENTION=90d
INFLUXDB_TOKEN=CHANGE_ME
INFLUXDB_ORG=noc_org
INFLUXDB_BUCKET=noc_metrics

# Chiffre les mots de passe des équipements en base. Ne pas changer sans
# suivre docs/ROTATION_SECRETS.md (sinon les mots de passe sont perdus).
SECRET_KEY=CHANGE_ME
# Signe les sessions utilisateurs. DOIT être différent de SECRET_KEY.
JWT_SECRET=CHANGE_ME
# Durée d'une session (minutes)
ACCESS_TOKEN_MINUTES=480

# Premier compte administrateur, créé seulement si aucun utilisateur n'existe.
# Après la première connexion : changez ce mot de passe dans l'interface puis videz la variable.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# Identifiants SMTP (facultatif ; le serveur et les destinataires se règlent dans l'interface)
SMTP_USER=
SMTP_PASSWORD=

# Port HTTP publié par Nginx, et adresse d'écoute sur l'hôte.
# Derrière un reverse proxy (Traefik, Dokploy…) : HTTP_BIND=127.0.0.1 pour ne pas exposer le port.
HTTP_PORT=80
HTTP_BIND=0.0.0.0
# Développement uniquement (Vite sur un autre port) : origines autorisées, séparées par des virgules
CORS_ORIGINS=

# Mode démonstration : équipements fictifs (*.demo.invalid) rafraîchis chaque minute,
# signalés « Démo » dans l'interface. Pour un environnement de test ou de formation
# UNIQUEMENT — jamais en production.
DEMO_DATA=false

# Autorité de certification interne pour vérifier les certificats des équipements
# (mode « vérifié par une AC »). Chemin d'un fichier PEM monté dans les conteneurs
# backend / celery_worker, par exemple via un volume « ./certs:/certs:ro ».
DEVICE_CA_BUNDLE=

# ── Connexion Active Directory (LDAP) ────────────────────────────────────────
# Les utilisateurs se connectent avec leur compte Windows ; le rôle vient de leurs
# groupes AD (groupes imbriqués compris). Le compte local « admin » reste utilisable
# en secours. Connexion chiffrée obligatoire (ldaps:// ou LDAP_START_TLS=true).
LDAP_ENABLED=false
# Plusieurs contrôleurs possibles, séparés par des virgules (bascule automatique)
LDAP_URL=ldaps://dc01.adcm.orangecm:636,ldaps://dc02.adcm.orangecm:636
LDAP_START_TLS=false
# AC qui a signé le certificat des contrôleurs de domaine (fichier PEM monté)
LDAP_CA_FILE=
LDAP_BASE_DN=DC=adcm,DC=orangecm
# Compte de service en lecture seule, utilisé pour rechercher les utilisateurs
LDAP_BIND_DN=CN=svc-noc-dashboard,OU=Services,DC=adcm,DC=orangecm
LDAP_BIND_PASSWORD=CHANGE_ME
# DN complets des groupes AD donnant chaque rôle (au moins un)
LDAP_GROUP_ADMIN=CN=NOC-Dashboard-Admins,OU=Groupes,DC=adcm,DC=orangecm
LDAP_GROUP_OPERATOR=CN=NOC-Dashboard-Operateurs,OU=Groupes,DC=adcm,DC=orangecm
LDAP_GROUP_VIEWER=CN=NOC-Dashboard-Lecteurs,OU=Groupes,DC=adcm,DC=orangecm
# Libellé affiché sur l'écran de connexion
LDAP_DOMAIN_LABEL=ADCM
