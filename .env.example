# ==============================================================================
# NOC Dashboard v2 — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs.
# NE JAMAIS commiter le fichier .env dans git.
# ==============================================================================

# PostgreSQL
POSTGRES_DB=noc_dashboard
POSTGRES_USER=noc_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# InfluxDB
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=noc_operator
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_ME_influx_password
DOCKER_INFLUXDB_INIT_ORG=noc_org
DOCKER_INFLUXDB_INIT_BUCKET=noc_metrics
DOCKER_INFLUXDB_INIT_RETENTION=30d
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=CHANGE_ME_generate_random_token_64chars

# Backend FastAPI
DATABASE_URL=postgresql://noc_admin:CHANGE_ME_strong_password@db:5432/noc_dashboard
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=CHANGE_ME_generate_random_token_64chars
INFLUXDB_ORG=noc_org
INFLUXDB_BUCKET=noc_metrics
REDIS_URL=redis://redis:6379/0
# Clé secrète JWT — générer avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_python_secrets
# Clé interne API Celery → endpoint /devices/active-for-polling
INTERNAL_API_KEY=CHANGE_ME_generate_with_python_secrets

# Frontend
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
