# ==============================================================================
# NOC INFRA — secrets FACULTATIFS  (/etc/noc/secrets.env, root uniquement, mode 600)
# Les secrets obligatoires (base, InfluxDB, SECRET_KEY, JWT_SECRET…) sont gérés par
# « podman secret » (install.sh) et n'apparaissent dans aucun fichier.
# Après modification : systemctl restart noc-backend noc-worker
# ==============================================================================
# Compte de service Active Directory (si LDAP_ENABLED=true dans noc.env)
LDAP_BIND_PASSWORD=
# Authentification SMTP pour les alertes e-mail (si le relais l'exige)
SMTP_USER=
SMTP_PASSWORD=
