# ==============================================================================
# NOC INFRA — configuration NON SECRÈTE du serveur RHEL  (/etc/noc/noc.env)
# Les secrets (mots de passe, jetons) sont dans les « podman secrets » créés par
# install.sh, et les secrets facultatifs (LDAP, SMTP) dans /etc/noc/secrets.env (600).
# Après modification : systemctl restart noc-backend noc-worker noc-beat
# ==============================================================================
TZ=Africa/Douala

# Services internes (noms des conteneurs sur le réseau podman « noc »)
# Redis : URL avec mot de passe fournie par le podman secret noc_redis_url.
INFLUXDB_URL=http://noc-influxdb:8086
INFLUXDB_ORG=noc_org
INFLUXDB_BUCKET=noc_metrics

# PostgreSQL / InfluxDB (initialisation)
POSTGRES_USER=noc_admin
POSTGRES_DB=noc_dashboard
PGDATA=/var/lib/postgresql/data/pgdata
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=noc_operator
DOCKER_INFLUXDB_INIT_ORG=noc_org
DOCKER_INFLUXDB_INIT_BUCKET=noc_metrics
DOCKER_INFLUXDB_INIT_RETENTION=90d

# Application
ADMIN_USERNAME=admin
ACCESS_TOKEN_MINUTES=480
DEMO_DATA=false
# AC interne des équipements : déposez le fichier PEM dans /etc/noc/ca/ puis
# DEVICE_CA_BUNDLE=/certs/devices-ca.pem
DEVICE_CA_BUNDLE=

# Active Directory (voir docs/DEPLOIEMENT_RHEL.md). Mot de passe du compte de
# service : LDAP_BIND_PASSWORD dans /etc/noc/secrets.env.
LDAP_ENABLED=false
LDAP_URL=
LDAP_START_TLS=false
# ex. /certs/ldap-ca.pem (fichier déposé dans /etc/noc/ca/)
LDAP_CA_FILE=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_GROUP_ADMIN=
LDAP_GROUP_OPERATOR=
LDAP_GROUP_VIEWER=
LDAP_DOMAIN_LABEL=ADCM
