[Unit]
Description=NOC INFRA — interface web (HTTPS)
Requires=noc-backend.service
After=noc-backend.service

[Container]
ContainerName=noc-frontend
Image=localhost/noc-frontend:current
Network=noc.network
# 443 → HTTPS, 80 → redirection vers HTTPS
PublishPort=443:8443
PublishPort=80:8080
Volume=/etc/noc/nginx-tls.conf:/etc/nginx/conf.d/default.conf:ro,z
Volume=/etc/noc/tls/tls.crt:/etc/nginx/tls/tls.crt:ro,z
# Clé privée transmise en secret, lisible par le seul utilisateur nginx (uid 101)
Secret=noc_tls_key,type=mount,target=/etc/nginx/tls/tls.key,uid=101,gid=101,mode=0400
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=wget -q --spider --no-check-certificate https://127.0.0.1:8443/
HealthInterval=30s
PodmanArgs=--memory=128m

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
